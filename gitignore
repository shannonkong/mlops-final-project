# Secrets — never commit API keys or credentials
# ---------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------
# Python
# ---------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# ---------------------------------------------
# Data
# DVC manages the data files and adds its own .gitignore
# entries when you run `dvc add`. Commit the small .dvc
# files it creates; the data itself stays out of Git.
# ---------------------------------------------
/data/raw/*
/data/processed/*
!/data/raw/.gitkeep
!/data/processed/.gitkeep
!/data/**/*.dvc

# DVC local cache and temp files
.dvc/cache/
.dvc/tmp/
.dvc/config.local

# ---------------------------------------------
# MLflow (local tracking store and artifacts)
# ---------------------------------------------
mlruns/
mlartifacts/
mlflow.db

# ---------------------------------------------
# Monitoring outputs (regenerated by the pipeline)
# Save the screenshots you need for slides elsewhere.
# ---------------------------------------------
monitoring/logs/
monitoring/reports/

